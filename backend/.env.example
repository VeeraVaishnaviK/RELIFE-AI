# MongoDB Configuration (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
DB_NAME=relife_db

# Security & Authentication
JWT_SECRET=supersecretrelifejwtkey2025securecircularityplatform
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Vision Fallback (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
